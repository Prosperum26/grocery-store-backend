STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
# Required: the hot-stock module (stock holds before payment) does not start without Redis (Docker container from the README).
# Medusa's own event bus, cache and locking are still in-memory.
REDIS_URL=redis://localhost:6379
# Optional key prefix (default c4f:, tests use c4f-test:).
HOT_STOCK_PREFIX=
# The "Mua lại" ranking is cached in the same Redis for 30 minutes (key {prefix}basket:{customerId}). Set to off to skip it.
REORDER_CACHE=
# Fine for local development; use long random values anywhere else.
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
# postgres://<user>:<password>@localhost:5434/medusa-backend (Docker container from the README)
DATABASE_URL=
DB_NAME=medusa-backend
# Shared password of the demo admin and customers created by `npm run seed`. Leave empty to skip the demo data.
DEMO_PASSWORD=

# VNPAY sandbox. TMN code and hash secret come in the sandbox.vnpayment.vn sign-up email; put them in .env only, never commit.
# The backend does not start without these two (dummy values such as TESTTMN1 work for local development).
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Refund API (customer cancel). The sandbox may block refunds for some merchant accounts, see docs/contracts/verified-apis.md.
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
# Storefront page the customer returns to after paying (display only, it does not change the order).
VNPAY_RETURN_URL=http://localhost:8000/vn/checkout/vnpay-return
# The IPN (GET /hooks/vnpay/ipn) needs a public HTTPS URL: use a tunnel in development and register it in the VNPAY sandbox portal.
# Without a tunnel the IPN never reaches localhost, so no order is created. The return page then confirms the payment
# like the IPN (same signed parameters, same checks). Default: on outside production. Set true/false to force it.
VNPAY_RETURN_AS_IPN=

# AI service (repo grocery-store-ai), contract in docs/contracts/ai-service.md. Trợ lý Bếp (/store/ai/*) calls it.
# Port 8100 because the storefront uses 8000. Set these here (apps/backend/.env): `turbo dev` drops variables set in the shell.
AI_SERVICE_URL=http://localhost:8100
# Reorder model ("Mua lại", POST /api/v1/predict). Empty: same address as AI_SERVICE_URL (one process runs both modules).
# Set it when the reorder app runs as its own process (uvicorn src.apps.reorder:app --port 8101), so one module
# going down does not take the other with it. Unset or unreachable: the "Mua lại" block stays hidden.
AI_REORDER_URL=
# Shared key sent as the X-Internal-Key header; the same value goes in the AI service's .env. Never commit a real one.
AI_INTERNAL_KEY=
# Per-endpoint time limits (ms); past them the backend answers with its fallback (see the contract).
AI_PREDICT_TIMEOUT_MS=500
AI_SEARCH_TIMEOUT_MS=3000
AI_COPILOT_TIMEOUT_MS=35000
AI_RECIPE_TIMEOUT_MS=3000
AI_SUGGEST_TIMEOUT_MS=2000
AI_ASK_TIMEOUT_MS=35000
